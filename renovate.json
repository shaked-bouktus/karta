{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base branches: renovate.yaml forces main plus the three newest v*/release-* branches at run time; main alone applies otherwise.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "github-actions",
    "npm",
    "custom.regex"
  ],
  "ignoreDeps": [
    "github.com/dsx-ai-factory/workload-map/karta/sdk"
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "labels": [
    "renovate"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitBody": "Signed-off-by: {{{gitAuthor}}}",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "postUpgradeTasks": {
    "commands": [
      "make generate-licenses"
    ],
    "fileFilters": [
      "**/go.mod",
      "**/go.sum",
      "NOTICE",
      "THIRD_PARTY_LICENSES"
    ],
    "executionMode": "branch"
  },
  "vulnerabilityAlerts": {
    "labels": [
      "renovate",
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "description": "Versions annotated with a '# renovate:' comment on the line above, in the Makefile and workflow env blocks.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z_]+_VERSION\\s*(?:\\?=|:)\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    },
    {
      "description": "Go version in the GO_VERSION build argument of the Dockerfiles.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG GO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Bump the go directive itself; the default range strategy treats it as a floor and never moves it.",
      "matchDatasources": [
        "golang-version"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "One PR for the Go version across every go.mod and Dockerfile, so the toolchain never drifts between modules.",
      "matchDatasources": [
        "golang-version"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "golang base images follow the Go toolchain group; the GO_VERSION argument already carries the version.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Include indirect Go dependencies in grouped updates so shared versions can advance together.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Group non-major Go module updates.",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go modules"
    },
    {
      "description": "Group non-major GitHub Actions updates and digest pins.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major container image updates.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "container images"
    },
    {
      "description": "Group non-major headlamp-plugin npm updates.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "headlamp-plugin npm"
    },
    {
      "description": "Rewrite npm overrides entries even within range. Without it Renovate updates only the lockfile, with npm install <name>@<version>, which npm rejects with EOVERRIDE for a package that appears only under overrides.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "overrides"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group non-major Makefile and workflow tool updates, Renovate included.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchDatasources": [
        "!golang-version"
      ],
      "groupName": "build tools"
    },
    {
      "description": "Release branches only take patch and digest updates; vulnerability fixes still pass through vulnerabilityAlerts.",
      "matchBaseBranches": [
        "/^(v|release-)\\d+\\.\\d+$/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "pin",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "Regenerate SDK code, CRDs, SDK and exporter mocks, catalog files, and licenses after Go module or build tool updates.",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "postUpgradeTasks": {
        "commands": [
          "make tidy lib-generate lib-manifests lib-generate-mocks exporter-generate-mocks generate-samples generate-licenses"
        ],
        "fileFilters": [
          "**/go.mod",
          "**/go.sum",
          "karta/sdk/**",
          "dsx-workload-exporter/**/*_mock.go",
          "charts/karta/crds/**",
          "docs/catalog/**",
          "NOTICE",
          "THIRD_PARTY_LICENSES"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Release branches up to 0.2 predate the move of the library to karta/sdk and keep the older make target names and layout, so their regeneration runs those. From 0.3 on a release branch carries the same targets as main and falls through to the rule above. Drop this rule once 0.2 ages out of the base branches renovate.yaml selects.",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchBaseBranches": [
        "/^(v|release-)0\\.[0-2]$/"
      ],
      "postUpgradeTasks": {
        "commands": [
          "make generate manifests generate-mocks generate-licenses"
        ],
        "fileFilters": [
          "**/go.mod",
          "**/go.sum",
          "pkg/**",
          "charts/karta/crds/**",
          "NOTICE",
          "THIRD_PARTY_LICENSES"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Keep non-major security fixes enabled on release branches without overriding the major update restriction.",
      "matchJsonata": [
        "isVulnerabilityAlert = true"
      ],
      "enabled": true
    },
    {
      "description": "Keep major updates disabled unless the quarterly main-branch rule enables them.",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Run routine major updates on main on the first day of each calendar quarter.",
      "matchBaseBranches": [
        "main"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchJsonata": [
        "$not(isVulnerabilityAlert = true)"
      ],
      "enabled": true,
      "schedule": [
        "* * 1 1,4,7,10 *"
      ],
      "timezone": "UTC",
      "updateNotScheduled": false
    }
  ]
}
